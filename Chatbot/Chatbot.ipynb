   "source": [
    "## 5. Adding Code Evaluation and Execution Capabilities\n",
    "\n",
    "To make our coding assistant more powerful, we'll add the ability to execute and evaluate code directly in the notebook. This will allow users to test the code generated by the assistant."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "code-execution-imports",
   "metadata": {},
   "outputs": [],
   "source": [
    "import sys\n",
    "import io\n",
    "import traceback\n",
    "from contextlib import redirect_stdout, redirect_stderr"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "code-execution-class",
   "metadata": {},
   "outputs": [],
   "source": [
    "class CodeExecutor:\n",
    "    def __init__(self):\n",
    "        self.globals_dict = {}\n",
    "        \n",
    "    def execute_code(self, code, language='python'):\n",
    "        """Execute code and return the output and any errors"""\n",
    "        if language.lower() != 'python':\n",
    "            return None, f'Code execution is only supported for Python. Received: {language}'\n",
    "        \n",
    "        # Capture stdout and stderr\n",
    "        stdout_capture = io.StringIO()\n",
    "        stderr_capture = io.StringIO()\n",
    "        \n",
    "        try:\n",
    "            # Execute the code and capture output\n",
    "            with redirect_stdout(stdout_capture), redirect_stderr(stderr_capture):\n",
    "                exec(code, self.globals_dict)\n",
    "            \n",
    "            stdout = stdout_capture.getvalue()\n",
    "            stderr = stderr_capture.getvalue()\n",
    "            \n",
    "            return stdout, stderr\n",
    "        except Exception as e:\n",
    "            # Get the full traceback\n",
    "            error_msg = traceback.format_exc()\n",
    "            return None, error_msg\n",
    "    \n",
    "    def evaluate_code(self, code, test_cases=None, language='python'):\n",
    "        """Evaluate code against test cases"""\n",
    "        if language.lower() != 'python':\n",
    "            return f'Code evaluation is only supported for Python. Received: {language}'\n",
    "        \n",
    "        if not test_cases:\n",
    "            return 'No test cases provided for evaluation.'\n",
    "        \n",
    "        # Execute the main code first to define functions/classes\n",
    "        _, errors = self.execute_code(code, language)\n",
    "        if errors:\n",
    "            return f'Code execution failed:\n{errors}'\n",
    "        \n",
    "        # Run each test case\n",
    "        results = []\n",
    "        for i, test_case in enumerate(test_cases):\n",
    "            stdout, stderr = self.execute_code(test_case, language)\n",
    "            \n",
    "            if stderr:\n",
    "                results.append(f'Test {i+1}: FAILED\n{stderr}')\n",
    "            else:\n",
    "                results.append(f'Test {i+1}: PASSED\nOutput: {stdout}')\n",
    "        \n",
    "        return '\n\n'.join(results)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "extend-chatbot-interface",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Extend the ChatbotInterface class with code execution capabilities\n",
    "class EnhancedChatbotInterface(ChatbotInterface):\n",
    "    def __init__(self, assistant):\n",
    "        super().__init__(assistant)\n",
    "        self.code_executor = CodeExecutor()\n",
    "        \n",
    "        # Add execute code button\n",
    "        self.execute_button = widgets.Button(\n",
    "            description='Execute Code',\n",
    "            button_style='success',\n",
    "            icon='play'\n",
    "        )\n",
    "        self.execute_button.on_click(self.on_execute_clicked)\n",
    "    \n",
    "    def display_interface(self):\n",
    "        # Create layout\n",
    "        input_box = widgets.VBox([\n",
    "            self.input_area,\n",
    "            widgets.HBox([self.send_button, self.clear_button])\n",
    "        ])\n",
    "        \n",
    "        special_buttons = widgets.HBox([\n",
    "            self.analyze_button,\n",
    "            self.complete_button,\n",
    "            self.explain_button,\n",
    "            self.debug_button,\n",
    "            self.execute_button  # Add execute button\n",
    "        ])\n",
    "        \n",
    "        settings = widgets.HBox([\n",
    "            self.language_selector,\n",
    "            self.temperature_slider\n",
    "        ])\n",
    "        \n",
    "        # Display the interface\n",
    "        display(HTML('<h2>Coding Assistant Chatbot</h2>'))\n",
    "        display(self.output_area)\n",
    "        display(input_box)\n",
    "        display(special_buttons)\n",
    "        display(settings)\n",
    "        \n",
    "        # Display welcome message\n",
    "        self.display_assistant_message(\n",
    "            """# Welcome to the Coding Assistant! 👋\n\n""" + \n",
    "            """I can help you with coding tasks such as:\n\n""" + \n",
    "            """- Answering programming questions\n""" + \n",
    "            """- Generating code solutions\n""" + \n",
    "            """- Explaining code\n""" + \n",
    "            """- Debugging issues\n""" + \n",
    "            """- Analyzing code for improvements\n""" + \n",
    "            """- Executing Python code directly in the notebook\n\n""" + \n",
    "            """How can I help you today?"""\n",
    "        )\n",
    "    \n",
    "    def on_execute_clicked(self, button):\n",
    "        """Handle execute code button click"""\n",
    "        code = self.input_area.value.strip()\n",
    "        if not code:\n",
    "            self.display_assistant_message(\"Please enter some code to execute.\")\n",
    "            return\n",
    "        \n",
    "        language = self.language_selector.value\n",
    "        if language.lower() != 'python':\n",
    "            self.display_assistant_message(f\"Code execution is only supported for Python. Selected language: {language}\")\n",
    "            return\n",
    "        \n",
    "        # Display user message\n",
    "        self.display_user_message(f\"Execute this Python code:\n\n```python\n{code}\n```\")\n",
    "        \n",
    "        # Clear input area\n",
    "        self.input_area.value = ''\n",
    "        \n",
    "        # Execute the code\n",
    "        try:\n",
    "            stdout, stderr = self.code_executor.execute_code(code, language)\n",
    "            \n",
    "            if stderr:\n",
    "                # Code execution resulted in an error\n",
    "                response = f\"### Execution Error\n\n```\n{stderr}\n```\n\nWould you like me to help debug this code?\"\n",
    "            else:\n",
    "                # Code executed successfully\n",
    "                if stdout:\n",
    "                    response = f\"### Execution Result\n\n```\n{stdout}\n```\n\nThe code executed successfully!\"\n",
    "                else:\n",
    "                    response = \"The code executed successfully with no output.\"\n",
    "            \n",
    "            self.display_assistant_message(response)\n",
    "        except Exception as e:\n",
    "            self.display_assistant_message(f\"Error during execution: {str(e)}\n\nPlease try again.\")"
   ]
