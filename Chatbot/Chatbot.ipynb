",
    "                f'<strong>Assistant:</strong><br>{formatted_message}'
",
    "                f'</div>'\n",
    "            ))\n",
    "    \n",
    "    def on_send_clicked(self, button=None):\n",
    "        """Handle send button click"""\n",
    "        user_input = self.input_area.value.strip()\n",
    "        if not user_input:\n",
