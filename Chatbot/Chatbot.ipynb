   "id": "stackoverflow-data",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Function to scrape Stack Overflow questions and answers\n",
    "def scrape_stackoverflow(num_pages=5, tag='python'):\n",
    "    base_url = f'https://stackoverflow.com/questions/tagged/{tag}'\n",
    "    questions_data = []\n",
    "    \n",
    "    for page in tqdm(range(1, num_pages + 1), desc='Scraping Stack Overflow pages'):\n",
    "        url = f'{base_url}?tab=newest&page={page}'\n",
    "        response = requests.get(url, headers={'User-Agent': 'Mozilla/5.0'})\n",
    "        \n",
    "        if response.status_code == 200:\n",
    "            soup = BeautifulSoup(response.text, 'html.parser')\n",
    "            question_summaries = soup.select('.s-post-summary')\n",
    "            \n",
    "            for summary in question_summaries:\n",
    "                try:\n",
    "                    # Extract question title and link\n",
    "                    title_element = summary.select_one('.s-link')\n",
    "                    if title_element:\n",
    "                        title = title_element.get_text(strip=True)\n",
    "                        link = 'https://stackoverflow.com' + title_element['href']\n",
    "                        \n",
    "                        # Extract question details\n",
    "                        question_response = requests.get(link, headers={'User-Agent': 'Mozilla/5.0'})\n",
    "                        if question_response.status_code == 200:\n",
    "                            question_soup = BeautifulSoup(question_response.text, 'html.parser')\n",
    "                            \n",
    "                            # Get question body\n",
    "                            question_body_element = question_soup.select_one('.js-post-body')\n",
    "                            question_body = question_body_element.get_text(strip=True) if question_body_element else ''\n",
    "                            \n",
    "                            # Get answers\n",
    "                            answers = []\n",
    "                            answer_elements = question_soup.select('.answer')\n",
    "                            \n",
    "                            for answer_element in answer_elements:\n",
    "                                answer_body_element = answer_element.select_one('.js-post-body')\n",
    "                                if answer_body_element:\n",
    "                                    answer_body = answer_body_element.get_text(strip=True)\n",
    "                                    \n",
    "                                    # Check if this is an accepted answer\n",
    "                                    is_accepted = bool(answer_element.select_one('.js-accepted-answer-indicator'))\n",
    "                                    \n",
    "                                    # Get code blocks\n",
    "                                    code_blocks = []\n",
    "                                    for code_element in answer_body_element.select('pre code'):\n",
    "                                        code_blocks.append(code_element.get_text())\n",
    "                                    \n",
    "                                    answers.append({\n",
    "                                        'body': answer_body,\n",
    "                                        'is_accepted': is_accepted,\n",
    "                                        'code_blocks': code_blocks\n",
    "                                    })\n",
    "                            \n",
    "                            # Add to our dataset\n",
    "                            questions_data.append({\n",
    "                                'title': title,\n",
    "                                'body': question_body,\n",
    "                                'link': link,\n",
    "                                'answers': answers,\n",
    "                                'tag': tag\n",
    "                            })\n",
    "                            \n",
    "                            # Be nice to the server\n",
    "                            time.sleep(1)\n",
    "                except Exception as e:\n",
    "                    print(f'Error processing a question: {e}')\n",
    "                    continue\n",
    "        else:\n",
    "            print(f'Failed to fetch page {page}. Status code: {response.status_code}')\n",
    "    \n",
    "    return questions_data"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "github-data",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Function to prepare data from the Hugging Face code_search_net dataset\n",
    "def load_code_dataset(language='python', num_samples=1000):\n",
    "    try:\n",
    "        # Load the code_search_net dataset which contains code from GitHub\n",
    "        dataset = load_dataset('code_search_net', language)\n",
    "        \n",
    "        # Sample a subset for training\n",
    "        if num_samples and num_samples < len(dataset['train']):\n",
    "            train_indices = random.sample(range(len(dataset['train'])), num_samples)\n",
    "            dataset['train'] = dataset['train'].select(train_indices)\n",
    "        \n",
    "        # Extract relevant information\n",
    "        code_data = []\n",
    "        for item in tqdm(dataset['train'], desc=f'Processing {language} code samples'):\n",
    "            code_data.append({\n",
    "                'code': item['whole_func_string'],\n",
    "                'docstring': item['func_documentation_string'],\n",
    "                'language': language\n",
    "            })\n",
    "            \n",
    "        return code_data\n",
    "    except Exception as e:\n",
    "        print(f'Error loading code dataset: {e}')\n",
    "        return []"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "prepare-data",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Function to format the data for training\n",
    "def prepare_training_data(stackoverflow_data, code_data):\n",
    "    training_data = []\n",
    "    \n",
    "    # Process Stack Overflow data\n",
    "    for question in stackoverflow_data:\n",
    "        # Find accepted or first answer\n",
    "        answer = None\n",
    "        for ans in question['answers']:\n",
    "            if ans['is_accepted']:\n",
    "                answer = ans\n",
    "                break\n",
    "        if not answer and question['answers']:\n",
    "            answer = question['answers'][0]\n",
    "        \n",
    "        if answer:\n",
    "            # Format as a conversation\n",
    "            conversation = {\n",
    "                'input': f"Question: {question['title']}\n\n{question['body']}",\n",
    "                'output': f"Answer: {answer['body']}"\n",
    "            }\n",
    "            training_data.append(conversation)\n",
    "    \n",
    "    # Process code data\n",
    "    for code_item in code_data:\n",
    "        if code_item['docstring'] and len(code_item['docstring']) > 10:\n",
    "            # Format as a code generation task\n",
    "            conversation = {\n",
    "                'input': f"Write a {code_item['language']} function that: {code_item['docstring']}",\n",
    "                'output': code_item['code']\n",
    "            }\n",
    "            training_data.append(conversation)\n",
    "    \n",
    "    return training_data"
   ]
  },
