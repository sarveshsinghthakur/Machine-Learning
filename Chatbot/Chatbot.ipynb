    "    \n",
    "    def format_code_blocks(self, text):\n",
    "        """Format code blocks with syntax highlighting"""\n",
    "        # Use regex to find code blocks and apply syntax highlighting\n",
    "        pattern = r'```(\w*)\n([\s\S]*?)\n```'\n",
    "        \n",
    "        def replace_code_block(match):\n",
    "            lang = match.group(1) or 'plaintext'\n",
    "            code = match.group(2)\n",
    "            return f'<pre style="background-color: #f5f5f5; padding: 10px; border-radius: 5px; overflow-x: auto;"><code class="{lang}">{code}</code></pre>'\n",
    "        \n",
    "        # Replace code blocks\n",
    "        text = re.sub(pattern, replace_code_block, text)\n",
    "        \n",
    "        # Convert markdown to HTML\n",
    "        html = markdown.markdown(text)\n",
    "        \n",
    "        return html\n",
