   "cell_type": "markdown",
   "id": "model-architecture",
   "metadata": {},
   "source": [
    "## 3. Building the Chatbot Model Architecture\n",
    "\n",
    "For our coding assistant chatbot, we'll use a pre-trained language model that already has coding knowledge. We'll use the Hugging Face Transformers library to load and fine-tune a model specifically for coding tasks.\n",
    "\n",
    "We'll use a model that's already good at code generation, such as CodeLlama or a similar model."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "model-class",
   "metadata": {},
   "outputs": [],
   "source": [
    "class CodingAssistant:\n",
    "    def __init__(self, model_name='Salesforce/codegen-350M-mono', device=None):\n",
    "        \"\"\"
",
    "        Initialize the coding assistant with a pre-trained model.\n",
    "        \n",
    "        Args:\n",
    "            model_name (str): The name of the pre-trained model to use\n",
    "            device (str): The device to use for inference ('cpu' or 'cuda')\n",
    "        \"\"\"
",
    "        self.model_name = model_name\n",
    "        \n",
    "        # Determine device\n",
    "        if device is None:\n",
    "            self.device = 'cuda' if torch.cuda.is_available() else 'cpu'\n",
    "        else:\n",
    "            self.device = device\n",
    "            \n",
    "        print(f'Using device: {self.device}')\n",
    "        \n",
    "        # Load tokenizer and model\n",
    "        print(f'Loading model: {model_name}')\n",
    "        self.tokenizer = AutoTokenizer.from_pretrained(model_name)\n",
    "        self.model = AutoModelForCausalLM.from_pretrained(model_name)\n",
    "        self.model.to(self.device)\n",
    "        \n",
    "        # Create text generation pipeline\n",
    "        self.generator = pipeline('text-generation', model=self.model, tokenizer=self.tokenizer, device=0 if self.device == 'cuda' else -1)\n",
    "        \n",
    "        # History of conversations\n",
    "        self.conversation_history = []\n",
    "        \n",
    "    def fine_tune(self, training_data, epochs=3, batch_size=4, learning_rate=5e-5):\n",
    "        \"\"\"
",
    "        Fine-tune the model on coding-specific data.\n",
    "        \n",
    "        Args:\n",
    "            training_data (list): List of dictionaries with 'input' and 'output' keys\n",
    "            epochs (int): Number of training epochs\n",
    "            batch_size (int): Training batch size\n",
    "            learning_rate (float): Learning rate for optimization\n",
    "        \"\"\"
",
    "        # This is a simplified fine-tuning process\n",
    "        # In a real application, you would use a more sophisticated approach\n",
    "        \n",
    "        # Convert training data to the format expected by the model\n",
    "        formatted_data = []\n",
    "        for item in training_data:\n",
    "            formatted_data.append({\n",
    "                'text': f\"{item['input']}\n{item['output']}\"\n",
    "            })\n",
    "            \n",
    "        # Create a Hugging Face dataset\n",
    "        dataset = Dataset.from_pandas(pd.DataFrame(formatted_data))\n",
    "        \n",
    "        # Tokenize the dataset\n",
    "        def tokenize_function(examples):\n",
    "            return self.tokenizer(examples['text'], padding='max_length', truncation=True, max_length=512)\n",
    "        \n",
    "        tokenized_dataset = dataset.map(tokenize_function, batched=True)\n",
    "        \n",
    "        # Set up training arguments\n",
    "        from transformers import TrainingArguments, Trainer\n",
    "        \n",
    "        training_args = TrainingArguments(\n",
    "            output_dir='./results',\n",
    "            num_train_epochs=epochs,\n",
    "            per_device_train_batch_size=batch_size,\n",
    "            learning_rate=learning_rate,\n",
    "            weight_decay=0.01,\n",
    "            logging_dir='./logs',\n",
    "            logging_steps=10,\n",
    "        )\n",
    "        \n",
    "        # Create a trainer\n",
    "        trainer = Trainer(\n",
    "            model=self.model,\n",
    "            args=training_args,\n",
    "            train_dataset=tokenized_dataset,\n",
    "        )\n",
    "        \n",
    "        # Train the model\n",
    "        trainer.train()\n",
    "        \n",
    "        # Update the generator with the fine-tuned model\n",
    "        self.generator = pipeline('text-generation', model=self.model, tokenizer=self.tokenizer, device=0 if self.device == 'cuda' else -1)\n",
    "        \n",
    "        print('Fine-tuning complete!')\n",
    "        \n",
    "    def generate_response(self, user_input, max_length=500, temperature=0.7, include_history=True):\n",
    "        \"\"\"
",
    "        Generate a response to the user's input.\n",
    "        \n",
    "        Args:\n",
    "            user_input (str): The user's question or request\n",
    "            max_length (int): Maximum length of the generated response\n",
    "            temperature (float): Controls randomness in generation (higher = more random)\n",
    "            include_history (bool): Whether to include conversation history\n",
    "            \n",
    "        Returns:\n",
    "            str: The generated response\n",
    "        \"\"\"
",
    "        # Add the user's input to the conversation history\n",
    "        self.conversation_history.append({'role': 'user', 'content': user_input})\n",
    "        \n",
    "        # Prepare the prompt\n",
    "        if include_history and len(self.conversation_history) > 1:\n",
    "            # Include conversation history in the prompt\n",
    "            prompt = ''\n",
    "            for message in self.conversation_history[:-1]:\n",
    "                if message['role'] == 'user':\n",
    "                    prompt += f"User: {message['content']}\n"\n",
    "                else:\n",
    "                    prompt += f"Assistant: {message['content']}\n"\n",
    "            prompt += f"User: {user_input}\nAssistant:"\n",
    "        else:\n",
    "            # Just use the current input\n",
    "            prompt = f"User: {user_input}\nAssistant:"\n",
    "        \n",
    "        # Generate a response\n",
    "        response = self.generator(\n",
    "            prompt,\n",
    "            max_length=len(self.tokenizer(prompt)['input_ids']) + max_length,\n",
    "            temperature=temperature,\n",
    "            num_return_sequences=1,\n",
    "            pad_token_id=self.tokenizer.eos_token_id\n",
    "        )[0]['generated_text']\n",
    "        \n",
    "        # Extract just the assistant's response\n",
    "        response = response.split('Assistant:')[-1].strip()\n",
    "        \n",
    "        # Add the response to the conversation history\n",
    "        self.conversation_history.append({'role': 'assistant', 'content': response})\n",
    "        \n",
    "        return response\n",
    "    \n",
    "    def analyze_code(self, code, language='python'):\n",
    "        \"\"\"
",
    "        Analyze code for potential issues or improvements.\n",
    "        \n",
    "        Args:\n",
    "            code (str): The code to analyze\n",
    "            language (str): The programming language\n",
    "            \n",
    "        Returns:\n",
    "            str: Analysis of the code\n",
    "        \"\"\"
",
    "        prompt = f"""Analyze the following {language} code for potential issues, bugs, or improvements:\n\n```{language}\n{code}\n```\n\nProvide a detailed analysis including:\n1. Potential bugs or errors\n2. Performance issues\n3. Best practice violations\n4. Suggested improvements\n"""\n",
    "        \n",
    "        return self.generate_response(prompt, max_length=800, temperature=0.3)\n",
    "    \n",
    "    def complete_code(self, partial_code, language='python'):\n",
    "        \"\"\"
",
    "        Complete partial code.\n",
    "        \n",
    "        Args:\n",
    "            partial_code (str): The partial code to complete\n",
    "            language (str): The programming language\n",
    "            \n",
    "        Returns:\n",
    "            str: The completed code\n",
    "        \"\"\"
",
    "        prompt = f"""Complete the following {language} code:\n\n```{language}\n{partial_code}\n```\n\nProvide the full, completed code:"""\n",
    "        \n",
    "        return self.generate_response(prompt, max_length=800, temperature=0.3)\n",
    "    \n",
    "    def explain_code(self, code, language='python'):\n",
    "        \"\"\"
",
    "        Explain what the given code does.\n",
    "        \n",
    "        Args:\n",
    "            code (str): The code to explain\n",
    "            language (str): The programming language\n",
    "            \n",
    "        Returns:\n",
    "            str: Explanation of the code\n",
    "        \"\"\"
",
    "        prompt = f"""Explain the following {language} code in detail:\n\n```{language}\n{code}\n```\n\nProvide a clear, step-by-step explanation of what this code does:"""\n",
    "        \n",
    "        return self.generate_response(prompt, max_length=800, temperature=0.3)\n",
    "    \n",
    "    def debug_code(self, code, error_message, language='python'):\n",
    "        \"\"\"
",
    "        Debug code based on an error message.\n",
    "        \n",
    "        Args:\n",
    "            code (str): The code with the error\n",
    "            error_message (str): The error message\n",
    "            language (str): The programming language\n",
    "            \n",
    "        Returns:\n",
    "            str: Debugging help and fixed code\n",
    "        \"\"\"
",
    "        prompt = f"""Debug the following {language} code that produces this error:\n\n```{language}\n{code}\n```\n\nError message:\n```\n{error_message}\n```\n\nExplain what's causing the error and provide the corrected code:"""\n",
    "        \n",
    "        return self.generate_response(prompt, max_length=800, temperature=0.3)\n",
    "    \n",
    "    def save_model(self, path='./coding_assistant_model'):\n",
    "        \"\"\"
",
    "        Save the model and tokenizer to disk.\n",
    "        \n",
    "        Args:\n",
    "            path (str): The path to save the model to\n",
    "        \"\"\"
",
    "        os.makedirs(path, exist_ok=True)\n",
    "        self.model.save_pretrained(path)\n",
    "        self.tokenizer.save_pretrained(path)\n",
    "        print(f'Model saved to {path}')\n",
    "    \n",
    "    def load_model(self, path='./coding_assistant_model'):\n",
    "        \"\"\"
",
    "        Load the model and tokenizer from disk.\n",
    "        \n",
    "        Args:\n",
    "            path (str): The path to load the model from\n",
    "        \"\"\"
",
    "        self.tokenizer = AutoTokenizer.from_pretrained(path)\n",
    "        self.model = AutoModelForCausalLM.from_pretrained(path)\n",
    "        self.model.to(self.device)\n",
    "        self.generator = pipeline('text-generation', model=self.model, tokenizer=self.tokenizer, device=0 if self.device == 'cuda' else -1)\n",
    "        print(f'Model loaded from {path}')"
   ]
  },
