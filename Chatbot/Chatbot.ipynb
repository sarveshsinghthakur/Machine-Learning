   "source": [
    "# Collect a small sample of data for demonstration purposes\n",
    "# Note: In a real application, you would collect much more data\n",
    "\n",
    "# Collect Stack Overflow data (limited to avoid excessive API calls)\n",
    "print('Collecting Stack Overflow data...')\n",
